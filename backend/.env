# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=A2f7Fe7e8f6a827a7c3f2f5ac8d9a29eA21f

# Stock API - Get free key from https://finnhub.io/
FINNHUB_API_KEY=d5pon29r01qq2b68fnegd5pon29r01qq2b68fnf0

# Owner Account - This account is created on first database initialization
OWNER_EMAIL=owner@casino.local
OWNER_PASSWORD=ChangeThisPassword123!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Database (SQLite) — PERSISTENT. Leave DATABASE_PATH empty to store the
# database OUTSIDE the project folder so it survives restarts, updates,
# git pulls and re-downloads:
#   Windows : %APPDATA%\casino-website\casino.db
#   macOS   : ~/Library/Application Support/casino-website/casino.db
#   Linux   : ~/.local/share/casino-website/casino.db
# On a hosting provider mount a persistent disk and point at it, e.g.
#   DATA_DIR=/var/data            (folder for casino.db, backups/, uploads/)
# or DATABASE_PATH=/var/data/casino.db   (absolute, or relative to backend/)
DATABASE_PATH=
DATA_DIR=

# Rolling backups written next to the database (backups/casino-<time>.db)
DATABASE_BACKUP_INTERVAL_HOURS=6
DATABASE_BACKUP_KEEP=14